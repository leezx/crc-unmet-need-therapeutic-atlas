# Legacy phase 2 paths (kept even after the archive move: any older checkout
# that still has local biological files at the pre-move path must not have
# them suddenly unignored by this repository's own .gitignore).
phase2/03_data/raw/
phase2/03_data/processed/
phase2/06_results/

# Archived phase 2 biological data are local analysis inputs and must never be committed.
archive/phase2_fetal_state_track_v1/phase2/03_data/raw/
archive/phase2_fetal_state_track_v1/phase2/03_data/processed/
archive/phase2_fetal_state_track_v1/phase2/06_results/

# Module B-F biological data are local analysis inputs and must never be committed.
modules/*/data_lock/raw/
modules/*/data_lock/processed/
modules/*/results/

# Local validator/test by-products.
reports/generated/
__pycache__/
